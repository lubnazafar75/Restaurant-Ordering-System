<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="tracking.TrackingController" prefWidth="650.0" prefHeight="480.0"
      style="-fx-background-color: #0B0F19;">

    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
    </padding>

    <HBox spacing="12.0" alignment="CENTER_LEFT" 
          style="-fx-background-color: #161D30; -fx-background-radius: 8px;">
        <padding>
            <Insets top="10.0" right="12.0" bottom="10.0" left="12.0"/>
        </padding>
        <Label text="Search Tracking:" style="-fx-text-fill: #FFFFFF; -fx-font-weight: bold;" />
        <TextField fx:id="searchField" promptText="Type table number..." HBox.hgrow="ALWAYS"
                   style="-fx-background-color: #0B0F19; -fx-text-fill: #FFFFFF; -fx-prompt-text-fill: #607D8B; -fx-border-color: #FF4A85; -fx-border-radius: 4px;"/>
        <ComboBox fx:id="statusFilterComboBox" promptText="Filter Status"
                  style="-fx-background-color: #0B0F19; -fx-text-fill: #FFFFFF; -fx-border-color: #FF4A85; -fx-border-radius: 4px;"/>
    </HBox>

    <TableView fx:id="ordersTable" VBox.vgrow="ALWAYS" 
               style="-fx-background-color: #161D30; -fx-control-inner-background: #161D30; -fx-text-background-color: #FFFFFF; -fx-border-color: #161D30;">
        <columns>
            <TableColumn fx:id="idColumn" text="ID" prefWidth="85.0" />
            <TableColumn fx:id="nameColumn" text="Table Number" prefWidth="280.0" />
            <TableColumn fx:id="statusColumn" text="Current Status" prefWidth="220.0" />
        </columns>
    </TableView>

    <HBox spacing="15.0" alignment="CENTER_RIGHT" 
          style="-fx-background-color: #161D30; -fx-background-radius: 8px;">
        <padding>
            <Insets top="12.0" right="15.0" bottom="12.0" left="15.0"/>
        </padding>
        <Label text="Update Status Pipeline:" style="-fx-text-fill: #FFFFFF; -fx-font-weight: bold;"/>
        <ComboBox fx:id="actionStatusComboBox" promptText="Select Status"
                  style="-fx-background-color: #0B0F19; -fx-text-fill: #FFFFFF; -fx-border-color: #00E676; -fx-border-radius: 4px;"/>
        <Button text="Update Status" onAction="#handleUpdateStatus" 
                style="-fx-background-color: #00E676; -fx-text-fill: #0B0F19; -fx-font-weight: bold; -fx-background-radius: 4px; -fx-cursor: hand;"/>
    </HBox>
</VBox>