<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="billing.BillingController"
           prefWidth="750" prefHeight="700"
           style="-fx-background-color: #0B0F19;">


    <!-- ═══════════════════════════════════════════
     PANEL 1 — ENJOY YOUR MEAL
     ═══════════════════════════════════════════ -->
	<VBox fx:id="enjoyMealPanel"
	      alignment="CENTER"
	      spacing="28"
	      style="-fx-background-color: #0B0F19;">
	
	    <!-- Fixed size circle with dish icon -->
	    <StackPane alignment="CENTER"
	               maxWidth="180" maxHeight="180"
	               minWidth="180" minHeight="180">
	
	        <!-- Pink circle border — fixed size -->
	        <VBox prefWidth="180" prefHeight="180"
	              style="-fx-background-color: transparent;
	                     -fx-border-color: #FF4A85;
	                     -fx-border-width: 3;
	                     -fx-border-radius: 90;
	                     -fx-background-radius: 90;"/>
	
	        <!-- Dish icon centered -->
	        <Label fx:id="plateIcon"
	               text="🍽"
	               style="-fx-font-size: 65px;
	                       "/>
	    </StackPane>
	
	    <!-- Title — "Enjoy" pink, "Your Meal!" green -->
	    <!-- Title — all green -->
		<HBox alignment="CENTER" spacing="10">
		    <Label fx:id="enjoyMealTitle"
		           text="Enjoy Your Meal!"
		           style="-fx-text-fill: #00E676;
		                  -fx-font-size: 36px;
		                  -fx-font-weight: bold;"/>
		</HBox>
	
	    <!-- Subtitle — plain text no dashes -->
	    <HBox fx:id="enjoyMealSubtitle"
	          alignment="CENTER">
	        <Label text="Your order has been delivered"
	               style="-fx-text-fill: white;
	                      -fx-font-size: 14px;"/>
	    </HBox>
	
	   <!-- Show Receipt button — hover effect, no icon -->
		<Button fx:id="showReceiptButton"
		        text="Show Receipt  ›"
		        onAction="#handleShowReceipt"
		        prefWidth="280"
		        style="-fx-background-color: transparent;
		               -fx-text-fill: #FF4A85;
		               -fx-font-size: 16px;
		               -fx-font-weight: bold;
		               -fx-border-color: #FF4A85;
		               -fx-border-radius: 30;
		               -fx-background-radius: 30;
		               -fx-border-width: 3;
		               -fx-padding: 14 30 14 30;
		               -fx-cursor: hand;">
		    <VBox.margin>
		        <Insets top="4"/>
		    </VBox.margin>
		</Button>
		
	    <!-- Payment note — same width as button -->
	    <HBox alignment="CENTER_LEFT"
	          spacing="14"
	          prefWidth="280"
	          maxWidth="280"
	          style="-fx-background-color: #161D30;
	                 -fx-background-radius: 12;
	                 -fx-padding: 16 20 16 20;">
	
	        <!-- Green circle icon -->
	        <StackPane minWidth="46" minHeight="46"
	                   maxWidth="46" maxHeight="46">
	            <VBox prefWidth="46" prefHeight="46"
	                  style="-fx-background-color: transparent;
	                         -fx-border-color: #00E676;
	                         -fx-border-width: 2;
	                         -fx-border-radius: 23;
	                         -fx-background-radius: 23;"/>
	            <Label text="💳"
	                   style="-fx-font-size: 18px;"/>
	        </StackPane>
	
	        <Label text="Payment is collected at the counter"
	               wrapText="true"
	               prefWidth="180"
	               style="-fx-text-fill: white;
	                      -fx-font-size: 13px;"/>
	    </HBox>
	
	</VBox>
    <!-- ═══════════════════════════════════════════
         PANEL 2 — RECEIPT
         ═══════════════════════════════════════════ -->
    <VBox fx:id="receiptPanel"
          alignment="TOP_LEFT"
          visible="false"
          managed="false"
          style="-fx-background-color: #0B0F19;">
          
          <!-- Back button — top left, pink hover -->
		<Button text="‹  Back"
		        onAction="#handleBackToEnjoyMeal"
		        onMouseEntered="#handleBackHoverIn"
		        onMouseExited="#handleBackHoverOut"
		        fx:id="backButton"
		        style="-fx-background-color: transparent;
		               -fx-text-fill: #FF4A85;
		               -fx-font-size: 13px;
		               -fx-font-weight: bold;
		               -fx-border-color: #FF4A85;
		               -fx-border-radius: 20;
		               -fx-background-radius: 20;
		               -fx-border-width: 2;
		               -fx-cursor: hand;
		               -fx-padding: 8 18 8 18;">
		    <VBox.margin>
		        <Insets top="14" left="14"/>
		    </VBox.margin>
		</Button>

        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    style="-fx-background: transparent;
                           -fx-background-color: transparent;
                           -fx-border-color: transparent;"
                    VBox.vgrow="ALWAYS">

            <VBox alignment="TOP_CENTER"
                  style="-fx-background-color: #0B0F19;
                         -fx-padding: 20 60 20 60;">

                <!-- RECEIPT CARD -->
                <VBox spacing="10"
                      maxWidth="420"
                      style="-fx-background-color: #161D30;
                             -fx-background-radius: 18;
                             -fx-border-color: #FF4A85;
                             -fx-border-width: 2;
                             -fx-border-radius: 18;
                             -fx-padding: 18;">

                    <!-- RECEIPT label centered — bigger -->
                    <Label text="RECEIPT"
                           maxWidth="420"
						   maxHeight="520"
                           alignment="CENTER"
                           style="-fx-text-fill: #FF4A85;
                                  -fx-font-size: 16px;
                                  -fx-font-weight: bold;"/>

                    <Separator style="-fx-background-color: #FF4A85;"/>

                    <!-- Table + Order ID + Date -->
                    <HBox>
                        <VBox HBox.hgrow="ALWAYS" spacing="3">
                            <Label fx:id="tableNumberLabel"
                                   text="Table —"
                                   style="-fx-text-fill: white;
                                          -fx-font-size: 20px;
                                          -fx-font-weight: bold;"/>
                            <Label fx:id="orderIdLabel"
                                   text="Order ID: —"
                                   style="-fx-text-fill: #666666;
                                          -fx-font-size: 12px;"/>
                        </VBox>
                        <VBox alignment="CENTER_RIGHT" spacing="3">
                            <Label fx:id="dateLabel"
                                   text="—"
                                   style="-fx-text-fill: #666666;
                                          -fx-font-size: 12px;"/>
                            <Label fx:id="timeLabel"
                                   text="—"
                                   style="-fx-text-fill: #666666;
                                          -fx-font-size: 12px;"/>
                        </VBox>
                    </HBox>

                    <Separator style="-fx-background-color: #2A3350;"/>

                     
                    <!-- Items populated by controller -->
                    <VBox fx:id="itemsVBox" spacing="10"/>

                    <Separator style="-fx-background-color: #2A3350;"/>

                   
					<!-- Subtotal / VAT — values on right -->
					<VBox spacing="9">
					    <HBox>
					        <Label text="Subtotal"
					               HBox.hgrow="ALWAYS"
					               maxWidth="Infinity"
					               style="-fx-text-fill: #888888;
					                      -fx-font-size: 14px;"/>
					        <Label fx:id="subtotalLabel"
					               text="GHS 0.00"
					               alignment="CENTER_RIGHT"
					               style="-fx-text-fill: #888888;
					                      -fx-font-size: 14px;"/>
					    </HBox>
					
					    <HBox>
					        <Label text="Discount"
					               HBox.hgrow="ALWAYS"
					               maxWidth="Infinity"
					               style="-fx-text-fill: #00E676;
					                      -fx-font-size: 14px;"/>
					        <Label fx:id="discountLabel"
					               text="- GHS 0.00"
					               alignment="CENTER_RIGHT"
					               style="-fx-text-fill: #00E676;
					                      -fx-font-size: 14px;"
					               visible="false" managed="false"/>
					    </HBox>
					
					    <HBox>
					        <Label text="VAT (10%)"
					               HBox.hgrow="ALWAYS"
					               maxWidth="Infinity"
					               style="-fx-text-fill: #888888;
					                      -fx-font-size: 14px;"/>
					        <Label fx:id="vatLabel"
					               text="GHS 0.00"
					               alignment="CENTER_RIGHT"
					               style="-fx-text-fill: #888888;
					                      -fx-font-size: 14px;"/>
					    </HBox>
					</VBox>
                    <Separator style="-fx-background-color: #FF4A85;"/>

                     
                    <!-- Total Paid — properly spaced -->
					<HBox alignment="CENTER_LEFT">
					    <Label text="Total Paid"
					           HBox.hgrow="ALWAYS"
					           maxWidth="Infinity"
					           style="-fx-text-fill: #FF4A85;
					                  -fx-font-size: 17px;
					                  -fx-font-weight: bold;"/>
					    <Label fx:id="totalLabel"
					           text="GHS 0.00"
					           alignment="CENTER_RIGHT"
					           style="-fx-text-fill: #00E676;
					                  -fx-font-size: 17px;
					                  -fx-font-weight: bold;"/>
					</HBox>																

                    <Separator style="-fx-background-color: #2A3350;"/>

                    <!-- Footer -->
                    <VBox spacing="4" alignment="CENTER">
                        <Label text="Thank you for dining with us."
                               maxWidth="Infinity"
                               alignment="CENTER"
                               style="-fx-text-fill: #666666;
                                      -fx-font-size: 13px;
                                      -fx-font-style: italic;"/>
                        <Label text="We look forward to serving you again."
                               maxWidth="Infinity"
                               alignment="CENTER"
                               style="-fx-text-fill: #666666;
                                      -fx-font-size: 13px;
                                      -fx-font-style: italic;"/>
                        <Label text="🤝"
                               maxWidth="Infinity"
                               alignment="CENTER"
                               style="-fx-font-size: 20px;">
                            <VBox.margin>
                                <Insets top="4"/>
                            </VBox.margin>
                        </Label>
                    </VBox>

                </VBox>
                <!-- END RECEIPT CARD -->

                <!-- Cashier note -->
                <VBox alignment="CENTER"
                      maxWidth="420"
                      style="-fx-background-color: #161D30;
                             -fx-background-radius: 10;
                             -fx-border-color: #FF4A85;
                             -fx-border-width: 1;
                             -fx-border-radius: 10;
                             -fx-padding: 14;">
                    <VBox.margin>
                        <Insets top="16"/>
                    </VBox.margin>
                    <Label text="🖨️  Want a printed receipt?"
                           maxWidth="Infinity"
                           alignment="CENTER"
                           style="-fx-text-fill: #FF4A85;
                                  -fx-font-size: 13px;
                                  -fx-font-weight: bold;"/>
                    <Label text="Please visit the cashier for collection."
                           maxWidth="Infinity"
                           alignment="CENTER"
                           style="-fx-text-fill: #888888;
                                  -fx-font-size: 12px;"/>
                </VBox>

            </VBox>
        </ScrollPane>
    </VBox>


    <!-- ═══════════════════════════════════════════
         PANEL 3 — PAYMENT CONFIRMED
         ═══════════════════════════════════════════ -->
    <VBox fx:id="paymentConfirmedPanel"
          alignment="CENTER"
          spacing="18"
          visible="false"
          managed="false"
          style="-fx-background-color: #0B0F19;">

        <StackPane alignment="CENTER">
            <VBox alignment="CENTER"
                  prefWidth="130" prefHeight="130"
                  style="-fx-background-color:
                         radial-gradient(center 50% 50%,
                         radius 50%,
                         #00E67640 0%,
                         #00E67610 60%,
                         transparent 100%);
                         -fx-background-radius: 65;"/>
            <Label text="✓"
                   style="-fx-text-fill: #00E676;
                          -fx-font-size: 65px;
                          -fx-font-weight: bold;"/>
        </StackPane>

        <Label text="Payment Confirmed!"
               style="-fx-text-fill: #00E676;
                      -fx-font-size: 28px;
                      -fx-font-weight: bold;"/>

        <Label text="Thank you for dining with us."
               style="-fx-text-fill: white;
                      -fx-font-size: 15px;"/>

        <HBox alignment="CENTER" spacing="8">
            <Pane prefWidth="40" prefHeight="1"
                  style="-fx-background-color: #00E676;"/>
            <Label text="✦"
                   style="-fx-text-fill: #00E676;
                          -fx-font-size: 10px;"/>
            <Pane prefWidth="40" prefHeight="1"
                  style="-fx-background-color: #00E676;"/>
        </HBox>

        <Label text="Returning to home screen..."
               style="-fx-text-fill: #444444;
                      -fx-font-size: 12px;
                      -fx-font-style: italic;"/>
    </VBox>

</StackPane>