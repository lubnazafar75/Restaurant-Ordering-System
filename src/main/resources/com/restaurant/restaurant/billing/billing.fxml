<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<HBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="billing.BillingController"
      style="-fx-background-color: #0B0F19;"
      prefWidth="1100" prefHeight="680">
    <VBox prefWidth="300"
          style="-fx-background-color: #0D1220;
                 -fx-border-color: #1E2740;
                 -fx-border-width: 0 1 0 0;">
        <VBox style="-fx-background-color: #0D1220;
                     -fx-padding: 22 18 14 18;
                     -fx-border-color: #1E2740;
                     -fx-border-width: 0 0 1 0;">
            <Label text="Billing"
                   style="-fx-text-fill: #FF4A85;
                          -fx-font-size: 22px;
                          -fx-font-weight: bold;"/>
            <Label text="Manage bills, payments and receipts."
                   style="-fx-text-fill: #555555;
                          -fx-font-size: 11px;"/>
        </VBox>
        <HBox style="-fx-padding: 12 12 0 12; -fx-spacing: 6;">
            <Button text="Active Tables"
                    style="-fx-background-color: #FF4A85;
                           -fx-text-fill: white;
                           -fx-font-size: 12px;
                           -fx-font-weight: bold;
                           -fx-background-radius: 20;
                           -fx-padding: 7 16 7 16;
                           -fx-cursor: hand;"/>
            <Button text="Completed Bills"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #555555;
                           -fx-font-size: 12px;
                           -fx-background-radius: 20;
                           -fx-border-color: #2A3350;
                           -fx-border-radius: 20;
                           -fx-padding: 7 16 7 16;
                           -fx-cursor: hand;"/>
        </HBox>
        <VBox style="-fx-padding: 10 12 6 12;">
            <TextField fx:id="searchField"
                       promptText="Search table or order..."
                       style="-fx-background-color: #161D30;
                              -fx-text-fill: white;
                              -fx-prompt-text-fill: #444444;
                              -fx-background-radius: 8;
                              -fx-border-color: #1E2740;
                              -fx-border-radius: 8;
                              -fx-padding: 9 12 9 12;
                              -fx-font-size: 12px;"/>
        </VBox>
        <VBox style="-fx-padding: 6 18 6 18;">
            <Label text="PENDING PAYMENTS"
                   style="-fx-text-fill: #444444;
                          -fx-font-size: 10px;
                          -fx-font-weight: bold;"/>
        </VBox>
        <ListView fx:id="orderListView"
                  VBox.vgrow="ALWAYS"
                  style="-fx-background-color: transparent;
                         -fx-border-color: transparent;
                         -fx-padding: 0 8 0 8;"/>
    </VBox>
    <VBox fx:id="receiptDetailPanel"
          HBox.hgrow="ALWAYS"
          style="-fx-background-color: #0B0F19;
                 -fx-padding: 26;
                 -fx-border-color: #1E2740;
                 -fx-border-width: 0 1 0 0;">
        <HBox alignment="CENTER_LEFT" spacing="12">
            <VBox HBox.hgrow="ALWAYS" spacing="6">
                <Label fx:id="tableNumberLabel"
                       text="Select an order"
                       style="-fx-text-fill: white;
                              -fx-font-size: 24px;
                              -fx-font-weight: bold;"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Ready to Bill"
                           style="-fx-background-color: #003320;
                                  -fx-text-fill: #00E676;
                                  -fx-font-size: 10px;
                                  -fx-font-weight: bold;
                                  -fx-background-radius: 5;
                                  -fx-padding: 3 10 3 10;"/>
                    <Label fx:id="orderIdLabel"
                           text=""
                           style="-fx-text-fill: #555555;
                                  -fx-font-size: 12px;"/>
                    <Label fx:id="timeLabel"
                           text=""
                           style="-fx-text-fill: #555555;
                                  -fx-font-size: 12px;"/>
                    <Label fx:id="dateLabel"
                           text=""
                           style="-fx-text-fill: #555555;
                                  -fx-font-size: 12px;"/>
                </HBox>
            </VBox>
        </HBox>
        <Separator style="-fx-background-color: #1E2740;">
            <VBox.margin>
                <Insets top="16" bottom="16"/>
            </VBox.margin>
        </Separator>
        <VBox fx:id="itemsVBox" spacing="2" VBox.vgrow="ALWAYS"/>
        <Separator style="-fx-background-color: #1E2740;">
            <VBox.margin>
                <Insets top="14" bottom="14"/>
            </VBox.margin>
        </Separator>
        <VBox spacing="8">
            <HBox>
                <Label text="Subtotal"
                       HBox.hgrow="ALWAYS"
                       maxWidth="Infinity"
                       style="-fx-text-fill: #888888; -fx-font-size: 13px;"/>
                <Label fx:id="subtotalLabel"
                       text="—"
                       alignment="CENTER_RIGHT"
                       style="-fx-text-fill: #888888; -fx-font-size: 13px;"/>
            </HBox>
            <HBox>
                <Label text="Discount"
                       HBox.hgrow="ALWAYS"
                       maxWidth="Infinity"
                       style="-fx-text-fill: #00E676; -fx-font-size: 13px;"/>
                <Label fx:id="discountLabel"
                       text="—"
                       alignment="CENTER_RIGHT"
                       style="-fx-text-fill: #00E676; -fx-font-size: 13px;"
                       visible="false" managed="false"/>
            </HBox>
            <HBox>
                <Label text="VAT (10%)"
                       HBox.hgrow="ALWAYS"
                       maxWidth="Infinity"
                       style="-fx-text-fill: #888888; -fx-font-size: 13px;"/>
                <Label fx:id="vatLabel"
                       text="—"
                       alignment="CENTER_RIGHT"
                       style="-fx-text-fill: #888888; -fx-font-size: 13px;"/>
            </HBox>
            <HBox style="-fx-padding: 6 0 2 0;">
                <Label text="Total Amount"
                       HBox.hgrow="ALWAYS"
                       maxWidth="Infinity"
                       style="-fx-text-fill: white;
                              -fx-font-size: 16px;
                              -fx-font-weight: bold;"/>
                <Label fx:id="totalLabel"
                       text="—"
                       alignment="CENTER_RIGHT"
                       style="-fx-text-fill: #FF4A85;
                              -fx-font-size: 18px;
                              -fx-font-weight: bold;"/>
            </HBox>
        </VBox>
        <HBox spacing="10">
            <VBox.margin>
                <Insets top="18"/>
            </VBox.margin>
            <Button fx:id="printBillButton"
                    text="Print Bill"
                    onAction="#handlePrintReceipt"
                    HBox.hgrow="ALWAYS"
                    maxWidth="Infinity"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: white;
                           -fx-font-size: 13px;
                           -fx-border-color: #2A3350;
                           -fx-border-radius: 8;
                           -fx-background-radius: 8;
                           -fx-padding: 12;
                           -fx-cursor: hand;"/>
        </HBox>
    </VBox>
    <VBox fx:id="cashPanel"
          prefWidth="280"
          spacing="16"
          style="-fx-background-color: #0D1220;
                 -fx-padding: 26;">
        <Label text="CASH PAYMENT"
               style="-fx-text-fill: white;
                      -fx-font-size: 15px;
                      -fx-font-weight: bold;"/>
        <VBox spacing="6">
            <Label text="Cash Received"
                   style="-fx-text-fill: #555555;
                          -fx-font-size: 11px;"/>
            <HBox alignment="CENTER_LEFT"
                  style="-fx-background-color: #161D30;
                         -fx-background-radius: 8;
                         -fx-border-color: #2A3350;
                         -fx-border-radius: 8;
                         -fx-padding: 0 0 0 12;">
                <Label text="GHS"
                       style="-fx-text-fill: #555555;
                              -fx-font-size: 14px;"/>
                <TextField fx:id="cashReceivedField"
                           promptText="0.00"
                           onKeyReleased="#handleCashInput"
                           HBox.hgrow="ALWAYS"
                           style="-fx-background-color: transparent;
                                  -fx-text-fill: white;
                                  -fx-font-size: 20px;
                                  -fx-font-weight: bold;
                                  -fx-border-color: transparent;
                                  -fx-padding: 10 12 10 8;"/>
            </HBox>
        </VBox>
        <VBox spacing="4"
              style="-fx-background-color: #161D30;
                     -fx-background-radius: 10;
                     -fx-padding: 16;">
            <Label text="Change Amount"
                   style="-fx-text-fill: #555555;
                          -fx-font-size: 11px;"/>
            <Label fx:id="changeAmountLabel"
                   text="Enter amount above"
                   style="-fx-text-fill: #888888;
                          -fx-font-size: 14px;"/>
        </VBox>
        <Separator style="-fx-background-color: #1E2740;"/>
        <VBox spacing="12">
            <Label text="PAYMENT SUMMARY"
                   style="-fx-text-fill: #444444;
                          -fx-font-size: 10px;
                          -fx-font-weight: bold;"/>
            <HBox>
                <Label text="Total Amount"
                       HBox.hgrow="ALWAYS"
                       style="-fx-text-fill: #888888; -fx-font-size: 13px;"/>
                <Label fx:id="paymentTotalLabel"
                       text="—"
                       style="-fx-text-fill: white;
                              -fx-font-size: 13px;
                              -fx-font-weight: bold;"/>
            </HBox>
            <HBox>
                <Label text="Amount Received"
                       HBox.hgrow="ALWAYS"
                       style="-fx-text-fill: #888888; -fx-font-size: 13px;"/>
                <Label fx:id="paymentReceivedLabel"
                       text="—"
                       style="-fx-text-fill: white;
                              -fx-font-size: 13px;
                              -fx-font-weight: bold;"/>
            </HBox>
            <HBox>
                <Label text="Change Amount"
                       HBox.hgrow="ALWAYS"
                       style="-fx-text-fill: #888888; -fx-font-size: 13px;"/>
                <Label fx:id="paymentChangeLabel"
                       text="—"
                       style="-fx-text-fill: #00E676;
                              -fx-font-size: 13px;
                              -fx-font-weight: bold;"/>
            </HBox>
        </VBox>
        <VBox VBox.vgrow="ALWAYS"/>
        <Button fx:id="confirmPaymentButton"
                text="Confirm Payment"
                onAction="#handleConfirmPayment"
                maxWidth="Infinity"
                style="-fx-background-color: #00E676;
                       -fx-text-fill: black;
                       -fx-font-size: 14px;
                       -fx-font-weight: bold;
                       -fx-background-radius: 8;
                       -fx-padding: 13;
                       -fx-cursor: hand;"/>
    </VBox>
</HBox>