<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.restaurant.restaurant.billing.BillingController"
           prefWidth="750" prefHeight="700"
           styleClass="screen-root">

    <!-- ═══════════════════════════════════════════
     PANEL 1 — ENJOY YOUR MEAL
     ═══════════════════════════════════════════ -->
    <VBox fx:id="enjoyMealPanel"
          alignment="CENTER"
          spacing="28"
          styleClass="screen-root">

        <StackPane alignment="CENTER"
                   maxWidth="180" maxHeight="180"
                   minWidth="180" minHeight="180">
            <VBox prefWidth="180" prefHeight="180"
                  style="-fx-background-color: #F0FDF4;
                         -fx-border-color: #10B981;
                         -fx-border-width: 3;
                         -fx-border-radius: 90;
                         -fx-background-radius: 90;"/>
            <Label fx:id="plateIcon"
                   text="🍽"
                   style="-fx-font-size: 65px;"/>
        </StackPane>

        <HBox alignment="CENTER" spacing="10">
            <Label fx:id="enjoyMealTitle"
                   text="Enjoy Your Meal!"
                   style="-fx-text-fill: #10B981;
                          -fx-font-size: 36px;
                          -fx-font-weight: bold;"/>
        </HBox>

        <HBox fx:id="enjoyMealSubtitle" alignment="CENTER">
            <Label text="Your order has been delivered"
                   styleClass="label-muted"
                   style="-fx-font-size: 14px;"/>
        </HBox>

        <Button fx:id="showReceiptButton"
                text="Show Receipt  ›"
                onAction="#handleShowReceipt"
                prefWidth="280"
                styleClass="btn-secondary"
                style="-fx-font-size: 16px; -fx-background-radius: 30; -fx-border-radius: 30;">
            <VBox.margin><Insets top="4"/></VBox.margin>
        </Button>

        <HBox alignment="CENTER_LEFT"
              spacing="14"
              prefWidth="280" maxWidth="280"
              style="-fx-background-color: white;
                     -fx-background-radius: 12;
                     -fx-border-color: #E5E7EB;
                     -fx-border-width: 1;
                     -fx-padding: 16 20 16 20;
                     -fx-effect: dropshadow(gaussian, rgba(31,41,55,0.05), 8, 0, 0, 2);">
            <StackPane minWidth="46" minHeight="46"
                       maxWidth="46" maxHeight="46">
                <VBox prefWidth="46" prefHeight="46"
                      style="-fx-background-color: #F0FDF4;
                             -fx-border-color: #10B981;
                             -fx-border-width: 2;
                             -fx-border-radius: 23;
                             -fx-background-radius: 23;"/>
                <Label text="💳" style="-fx-font-size: 18px;"/>
            </StackPane>
            <Label text="Payment is collected at the counter"
                   wrapText="true" prefWidth="180"
                   style="-fx-text-fill: #374151; -fx-font-size: 13px;"/>
        </HBox>

        <!-- Back to Menu button -->
        <Button text="← Order More"
                onAction="#handleOrderMore"
                prefWidth="280"
                styleClass="btn-ghost"
                style="-fx-font-size: 14px; -fx-background-radius: 30; -fx-border-radius: 30; -fx-padding: 12 30;"/>
    </VBox>

    <!-- ═══════════════════════════════════════════
         PANEL 2 — RECEIPT
         ═══════════════════════════════════════════ -->
    <VBox fx:id="receiptPanel"
          alignment="TOP_LEFT"
          visible="false" managed="false"
          styleClass="screen-root">

        <Button text="‹  Back"
                onAction="#handleBackToEnjoyMeal"
                onMouseEntered="#handleBackHoverIn"
                onMouseExited="#handleBackHoverOut"
                fx:id="backButton"
                styleClass="btn-secondary"
                style="-fx-font-size: 13px; -fx-background-radius: 20; -fx-border-radius: 20; -fx-padding: 8 18;">
            <VBox.margin><Insets top="14" left="14"/></VBox.margin>
        </Button>

        <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
                    styleClass="scroll-pane"
                    VBox.vgrow="ALWAYS">
            <VBox alignment="TOP_CENTER"
                  style="-fx-background-color: #F8FAFC;
                         -fx-padding: 20 60 20 60;">

                <!-- RECEIPT CARD -->
                <VBox spacing="10" maxWidth="420"
                      styleClass="receipt-card">

                    <Label text="RECEIPT"
                           maxWidth="420"
                           alignment="CENTER"
                           style="-fx-text-fill: #10B981;
                                  -fx-font-size: 16px;
                                  -fx-font-weight: bold;
                                  -fx-alignment: center;"/>

                    <Separator style="-fx-background-color: #D1FAE5;"/>

                    <HBox>
                        <VBox HBox.hgrow="ALWAYS" spacing="3">
                            <Label fx:id="tableNumberLabel"
                                   text="Table —"
                                   style="-fx-text-fill: #1F2937;
                                          -fx-font-size: 20px;
                                          -fx-font-weight: bold;"/>
                            <Label fx:id="orderIdLabel"
                                   text="Order ID: —"
                                   style="-fx-text-fill: #9CA3AF;
                                          -fx-font-size: 12px;"/>
                        </VBox>
                        <VBox alignment="CENTER_RIGHT" spacing="3">
                            <Label fx:id="dateLabel" text="—"
                                   style="-fx-text-fill: #9CA3AF; -fx-font-size: 12px;"/>
                            <Label fx:id="timeLabel" text="—"
                                   style="-fx-text-fill: #9CA3AF; -fx-font-size: 12px;"/>
                        </VBox>
                    </HBox>

                    <Separator style="-fx-background-color: #E5E7EB;"/>

                    <VBox fx:id="itemsVBox" spacing="10"/>

                    <Separator style="-fx-background-color: #E5E7EB;"/>

                    <VBox spacing="9">
                        <HBox>
                            <Label text="Subtotal"
                                   HBox.hgrow="ALWAYS" maxWidth="Infinity"
                                   style="-fx-text-fill: #6B7280; -fx-font-size: 14px;"/>
                            <Label fx:id="subtotalLabel" text="GHS 0.00"
                                   alignment="CENTER_RIGHT"
                                   style="-fx-text-fill: #6B7280; -fx-font-size: 14px;"/>
                        </HBox>
                        <HBox>
                            <Label text="Discount"
                                   HBox.hgrow="ALWAYS" maxWidth="Infinity"
                                   style="-fx-text-fill: #10B981; -fx-font-size: 14px;"/>
                            <Label fx:id="discountLabel" text="- GHS 0.00"
                                   alignment="CENTER_RIGHT"
                                   style="-fx-text-fill: #10B981; -fx-font-size: 14px;"
                                   visible="false" managed="false"/>
                        </HBox>
                        <HBox>
                            <Label text="VAT (10%)"
                                   HBox.hgrow="ALWAYS" maxWidth="Infinity"
                                   style="-fx-text-fill: #6B7280; -fx-font-size: 14px;"/>
                            <Label fx:id="vatLabel" text="GHS 0.00"
                                   alignment="CENTER_RIGHT"
                                   style="-fx-text-fill: #6B7280; -fx-font-size: 14px;"/>
                        </HBox>
                    </VBox>

                    <Separator style="-fx-background-color: #D1FAE5;"/>

                    <HBox alignment="CENTER_LEFT">
                        <Label text="Total Paid"
                               HBox.hgrow="ALWAYS" maxWidth="Infinity"
                               style="-fx-text-fill: #1F2937;
                                      -fx-font-size: 17px;
                                      -fx-font-weight: bold;"/>
                        <Label fx:id="totalLabel" text="GHS 0.00"
                               alignment="CENTER_RIGHT"
                               style="-fx-text-fill: #10B981;
                                      -fx-font-size: 17px;
                                      -fx-font-weight: bold;"/>
                    </HBox>

                    <Separator style="-fx-background-color: #E5E7EB;"/>

                    <VBox spacing="4" alignment="CENTER">
                        <Label text="Thank you for dining with us."
                               maxWidth="Infinity" alignment="CENTER"
                               style="-fx-text-fill: #9CA3AF;
                                      -fx-font-size: 13px;
                                      -fx-font-style: italic;"/>
                        <Label text="We look forward to serving you again."
                               maxWidth="Infinity" alignment="CENTER"
                               style="-fx-text-fill: #9CA3AF;
                                      -fx-font-size: 13px;
                                      -fx-font-style: italic;"/>
                        <Label text="🤝" maxWidth="Infinity" alignment="CENTER"
                               style="-fx-font-size: 20px;">
                            <VBox.margin><Insets top="4"/></VBox.margin>
                        </Label>
                    </VBox>
                </VBox>

                <!-- Cashier note -->
                <VBox alignment="CENTER" maxWidth="420"
                      style="-fx-background-color: #F0FDF4;
                             -fx-background-radius: 10;
                             -fx-border-color: #D1FAE5;
                             -fx-border-width: 1;
                             -fx-border-radius: 10;
                             -fx-padding: 14;">
                    <VBox.margin><Insets top="16"/></VBox.margin>
                    <Label text="🖨️  Want a printed receipt?"
                           maxWidth="Infinity" alignment="CENTER"
                           style="-fx-text-fill: #059669;
                                  -fx-font-size: 13px;
                                  -fx-font-weight: bold;"/>
                    <Label text="Please visit the cashier for collection."
                           maxWidth="Infinity" alignment="CENTER"
                           style="-fx-text-fill: #6B7280; -fx-font-size: 12px;"/>
                </VBox>
            </VBox>
        </ScrollPane>
    </VBox>

    <!-- ═══════════════════════════════════════════
         PANEL 3 — PAYMENT CONFIRMED
         ═══════════════════════════════════════════ -->
    <VBox fx:id="paymentConfirmedPanel"
          alignment="CENTER" spacing="18"
          visible="false" managed="false"
          styleClass="screen-root">

        <StackPane alignment="CENTER">
            <VBox alignment="CENTER"
                  prefWidth="130" prefHeight="130"
                  style="-fx-background-color:
                         radial-gradient(center 50% 50%,
                         radius 50%,
                         #10B98130 0%,
                         #10B98110 60%,
                         transparent 100%);
                         -fx-background-radius: 65;"/>
            <Label text="✓"
                   style="-fx-text-fill: #10B981;
                          -fx-font-size: 65px;
                          -fx-font-weight: bold;"/>
        </StackPane>

        <Label text="Payment Confirmed!"
               style="-fx-text-fill: #10B981;
                      -fx-font-size: 28px;
                      -fx-font-weight: bold;"/>
        <Label text="Thank you for dining with us."
               style="-fx-text-fill: #374151; -fx-font-size: 15px;"/>

        <HBox alignment="CENTER" spacing="8">
            <Pane prefWidth="40" prefHeight="1"
                  style="-fx-background-color: #10B981;"/>
            <Label text="✦"
                   style="-fx-text-fill: #10B981; -fx-font-size: 10px;"/>
            <Pane prefWidth="40" prefHeight="1"
                  style="-fx-background-color: #10B981;"/>
        </HBox>

        <Label text="Returning to home screen..."
               style="-fx-text-fill: #9CA3AF;
                      -fx-font-size: 12px;
                      -fx-font-style: italic;"/>
    </VBox>

</StackPane>