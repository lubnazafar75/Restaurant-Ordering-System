<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.restaurant.restaurant.billing.BillingController"
           prefWidth="900" prefHeight="700"
           styleClass="screen-root">

    <!-- ═══════════════════════════════════════════
         PANEL 1 — ENJOY YOUR MEAL
         (unchanged — keep as-is)
         ═══════════════════════════════════════════ -->
    <VBox fx:id="enjoyMealPanel"
          alignment="CENTER"
          spacing="28"
          styleClass="screen-root">

        <StackPane alignment="CENTER"
                   maxWidth="180" maxHeight="180"
                   minWidth="180" minHeight="180">
            <VBox prefWidth="180" prefHeight="180"
                  style="-fx-background-color: #F0FDF4;
                         -fx-border-color: #10B981;
                         -fx-border-width: 3;
                         -fx-border-radius: 90;
                         -fx-background-radius: 90;"/>
            <Label text="🍽"
                   style="-fx-font-size: 65px;-fx-text-fill: #10B981"/>
        </StackPane>

        <Label text="Enjoy Your Meal!"
               style="-fx-text-fill: #10B981;
                      -fx-font-size: 36px;
                      -fx-font-weight: bold;"/>

        <Label text="Your order has been delivered"
               styleClass="label-muted"
               style="-fx-font-size: 14px;"/>

        <Button text="Show Receipt  ›"
                onAction="#handleShowReceipt"
                prefWidth="280"
                styleClass="btn-secondary"
                style="-fx-font-size: 16px; -fx-background-radius: 30;-fx-border-color:#10B981 ; -fx-border-radius: 30;-fx-text-fill: #10B981">
            <VBox.margin><Insets top="4"/></VBox.margin>
        </Button>

        <HBox alignment="CENTER_LEFT"
              spacing="14"
              prefWidth="280" maxWidth="280"
              style="-fx-background-color: white;
                     -fx-background-radius: 12;
                     -fx-border-color: #E5E7EB;
                     -fx-border-width: 1;
                     -fx-padding: 16 20 16 20;
                     -fx-effect: dropshadow(gaussian, rgba(31,41,55,0.05), 8, 0, 0, 2);">
            <StackPane minWidth="46" minHeight="46"
                       maxWidth="46" maxHeight="46">
                <VBox prefWidth="46" prefHeight="46"
                      style="-fx-background-color: #F0FDF4;
                             -fx-border-color: #10B981;
                             -fx-border-width: 2;
                             -fx-border-radius: 23;
                             -fx-background-radius: 23;"/>
                <Label text="💳" style="-fx-font-size: 18px;-fx-text-fill: #10B981"/>
            </StackPane>
            <Label text="Payment is collected at the counter"
                   wrapText="true" prefWidth="180"
                   style="-fx-text-fill: #374151; -fx-font-size: 13px;"/>
        </HBox>

        <Button text="← Order More"
                onAction="#handleOrderMore"
                prefWidth="280"
                styleClass="btn-ghost"
                style="-fx-font-size: 14px; -fx-background-radius: 30; -fx-border-radius: 30; -fx-padding: 12 30;"/>
    </VBox>

    <!-- ═══════════════════════════════════════════
         PANEL 2 — DINED & DELIGHTED (Receipt + Rating)
         ═══════════════════════════════════════════ -->
    <VBox fx:id="receiptPanel"
          visible="false" managed="false"
          styleClass="screen-root">

        <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
                    styleClass="scroll-pane"
                    VBox.vgrow="ALWAYS">

            <VBox alignment="TOP_CENTER" spacing="0"
                  style="-fx-background-color: #F8FAFC; -fx-padding: 40 60 40 60;">

                <!-- ── HEADER ── -->
                <VBox alignment="CENTER" spacing="10">
                    <!-- Checkmark circle -->
                    <StackPane alignment="CENTER"
                               maxWidth="64" maxHeight="64"
                               minWidth="64" minHeight="64">
                        <VBox prefWidth="64" prefHeight="64"
                              style="-fx-background-color: #F0FDF4;
                                     -fx-border-color: #10b981;
                                     -fx-border-width: 2.5;
                                     -fx-border-radius: 32;
                                     -fx-background-radius: 32;"/>
                        <Label text="✓"
                               style="-fx-text-fill: #10B981;
                                      -fx-font-size: 28px;
                                      -fx-font-weight: bold;"/>
                    </StackPane>

                    <Label text="Dined &amp; Delighted!"
                           style="-fx-text-fill: #10b981;
                                  -fx-font-size: 45px;
                                  -fx-font-weight: bold;"/>

                    <Label text="We hope your culinary session with Savoria was nothing short of extraordinary."
                           wrapText="true"
                           maxWidth="520"
                           style="-fx-text-fill: #6B7280;
                                  -fx-font-size: 14px;
                                  -fx-text-alignment: center;
                                  -fx-alignment: center;"/>
                </VBox>

                <VBox.margin><Insets bottom="32"/></VBox.margin>

                <!-- ── TWO-COLUMN ROW ── -->
                <HBox spacing="24" alignment="TOP_CENTER">

                    <!-- ── LEFT CARD — Itemized Receipt ── -->
                    <VBox fx:id="receiptCard"
                          spacing="0"
                          HBox.hgrow="ALWAYS"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 18;
                                 -fx-border-color: #E5E7EB;
                                 -fx-border-width: 1;
                                 -fx-border-radius: 18;
                                 -fx-padding: 24;
                                 -fx-effect: dropshadow(gaussian, rgba(31,41,55,0.07), 14, 0, 0, 4);">

                        <!-- Card header row -->
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="📋"
                                   style="-fx-font-size: 18px;"/>
                            <Label text="Itemized Receipt"
                                   HBox.hgrow="ALWAYS"
                                   style="-fx-text-fill: #1F2937;
                                          -fx-font-size: 17px;
                                          -fx-font-weight: bold;"/>
                            <!-- Table number badge -->
                            <Label fx:id="tableNumberLabel"
                                   text="Table —"
                                   style="-fx-background-color: #F1F5F9;
                                          -fx-background-radius: 8;
                                          -fx-text-fill: #374151;
                                          -fx-font-size: 12px;
                                          -fx-font-weight: bold;
                                          -fx-padding: 5 12;"/>
                        </HBox>

                        <Separator style="-fx-background-color: #E5E7EB;">
                            <VBox.margin><Insets top="16" bottom="16"/></VBox.margin>
                        </Separator>

                        <!-- Dynamic items list -->
                        <VBox fx:id="itemsVBox" spacing="14"/>

                        <Separator style="-fx-background-color: #E5E7EB;">
                            <VBox.margin><Insets top="16" bottom="16"/></VBox.margin>
                        </Separator>

                        <!-- Subtotal / Tax rows -->
                        <VBox spacing="8">
                            <HBox>
                                <Label text="Subtotal Consumption"
                                       HBox.hgrow="ALWAYS"
                                       style="-fx-text-fill: #6B7280; -fx-font-size: 13px;"/>
                                <Label fx:id="subtotalLabel" text="GHS 0.00"
                                       style="-fx-text-fill: #6B7280; -fx-font-size: 13px;"/>
                            </HBox>
                            <HBox>
                                <Label text="Service Fee / Tax (Inc)"
                                       HBox.hgrow="ALWAYS"
                                       style="-fx-text-fill: #6B7280; -fx-font-size: 13px;"/>
                                <Label fx:id="vatLabel" text="GHS 0.00"
                                       style="-fx-text-fill: #6B7280; -fx-font-size: 13px;"/>
                            </HBox>
                        </VBox>

                        <Separator style="-fx-background-color: #E5E7EB;">
                            <VBox.margin><Insets top="14" bottom="14"/></VBox.margin>
                        </Separator>

                        <!-- Total -->
                        <HBox alignment="CENTER_LEFT">
                            <Label text="Total Bill Paid"
                                   HBox.hgrow="ALWAYS"
                                   style="-fx-text-fill: #1F2937;
                                          -fx-font-size: 16px;
                                          -fx-font-weight: bold;"/>
                            <Label fx:id="totalLabel" text="GHS 0.00"
                                   style="-fx-text-fill: #10B981;
                                          -fx-font-size: 18px;
                                          -fx-font-weight: bold;"/>
                        </HBox>

                        <!-- Request Physical Receipt button -->
                        <Button text="📄  Request Physical Receipt"
                                onAction="#handleRequestPhysicalReceipt"
                                maxWidth="Infinity"
                                styleClass="btn-secondary"
                                style="-fx-font-size: 14px;
                                -fx-text-fill: #10B981;
                                       -fx-background-radius: 12;
                                       -fx-border-radius: 12;
                                       -fx-border-color: #10B981;
                                       -fx-padding: 13 0;">
                            <VBox.margin><Insets top="20"/></VBox.margin>
                        </Button>

                    </VBox>

                    <!-- ── RIGHT CARD — Rate Your Experience ── -->
                    <VBox fx:id="ratingCard"
                          spacing="0"
                          HBox.hgrow="ALWAYS"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 18;
                                 -fx-border-color: #E5E7EB;
                                 -fx-border-width: 1;
                                 -fx-border-radius: 18;
                                 -fx-padding: 24;
                                 -fx-effect: dropshadow(gaussian, rgba(31,41,55,0.07), 14, 0, 0, 4);">

                        <!-- Card header -->
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="💬" style="-fx-font-size: 18px;"/>
                            <Label text="Rate Your Experience"
                                   style="-fx-text-fill: #1F2937;
                                          -fx-font-size: 17px;
                                          -fx-font-weight: bold;"/>
                        </HBox>

                        <Separator style="-fx-background-color: #E5E7EB;">
                            <VBox.margin><Insets top="16" bottom="20"/></VBox.margin>
                        </Separator>

                        <!-- Star Rating Rows -->
                        <VBox spacing="20">

                            <!-- Food Quality -->
                            <HBox alignment="CENTER_LEFT" spacing="0">
                                <Label text="Food Quality"
                                       HBox.hgrow="ALWAYS"
                                       style="-fx-text-fill: #374151; -fx-font-size: 14px;"/>
                                <HBox fx:id="foodQualityStars" spacing="6" alignment="CENTER_RIGHT"/>
                            </HBox>

                            <!-- Service Hospitality -->
                            <HBox alignment="CENTER_LEFT" spacing="0">
                                <Label text="Service Hospitality"
                                       HBox.hgrow="ALWAYS"
                                       style="-fx-text-fill: #374151; -fx-font-size: 14px;"/>
                                <HBox fx:id="serviceHospitalityStars" spacing="6" alignment="CENTER_RIGHT"/>
                            </HBox>

                            <!-- Delivery Speed -->
                            <HBox alignment="CENTER_LEFT" spacing="0">
                                <Label text="Delivery Speed"
                                       HBox.hgrow="ALWAYS"
                                       style="-fx-text-fill: #374151; -fx-font-size: 14px;"/>
                                <HBox fx:id="deliverySpeedStars" spacing="6" alignment="CENTER_RIGHT"/>
                            </HBox>

                            <!-- Overall Experience -->
                            <HBox alignment="CENTER_LEFT" spacing="0">
                                <VBox HBox.hgrow="ALWAYS" spacing="1">
                                    <Label text="Overall Experience"
                                           style="-fx-text-fill: #374151; -fx-font-size: 14px;"/>
                                    <Label text="(Required)"
                                           style="-fx-text-fill: #9CA3AF; -fx-font-size: 11px;"/>
                                </VBox>
                                <HBox fx:id="overallExperienceStars" spacing="6" alignment="CENTER_RIGHT"/>
                            </HBox>

                        </VBox>

                        <Separator style="-fx-background-color: #E5E7EB;">
                            <VBox.margin><Insets top="20" bottom="16"/></VBox.margin>
                        </Separator>

                        <!-- Comments section -->
                        <VBox spacing="8">
                            <Label text="COMMENTS &amp; SUGGESTIONS"
                                   style="-fx-text-fill: #9CA3AF;
                                          -fx-font-size: 10px;
                                          -fx-font-weight: bold;"/>
                            <TextArea fx:id="commentsArea"
                                      prefRowCount="4"
                                      promptText="Share any special notes about your chef, waiter speed, or dish freshness with us..."
                                      wrapText="true"
                                      style="-fx-background-color: white;
                                             -fx-border-color: #E5E7EB;
                                             -fx-border-width: 1.5;
                                             -fx-border-radius: 10;
                                             -fx-background-radius: 10;
                                             -fx-font-size: 13px;
                                             -fx-text-fill: #374151;
                                             -fx-prompt-text-fill: #9CA3AF;
                                             -fx-padding: 10 12;"/>
                        </VBox>

                        <!-- Submit Feedback button -->
                        <Button fx:id="submitFeedbackBtn"
                                text="Submit Feedback"
                                onAction="#handleSubmitFeedback"
                                maxWidth="Infinity"
                                styleClass="btn-primary"
                                style="-fx-font-size: 15px;

                                -fx-background-color: #F59E0B;

                                       -fx-background-radius: 12;
                                       -fx-padding: 14 0;">
                            <VBox.margin><Insets top="16"/></VBox.margin>
                        </Button>

                    </VBox>

                </HBox>

            </VBox>
        </ScrollPane>
    </VBox>

    <!-- ═══════════════════════════════════════════
         PANEL 3 — PAYMENT CONFIRMED (unchanged)
         ═══════════════════════════════════════════ -->
    <VBox fx:id="paymentConfirmedPanel"
          alignment="CENTER" spacing="18"
          visible="false" managed="false"
          styleClass="screen-root">

        <StackPane alignment="CENTER">
            <VBox alignment="CENTER"
                  prefWidth="130" prefHeight="130"
                  style="-fx-background-color:
                         radial-gradient(center 50% 50%,
                         radius 50%,
                         rgb(16 185 129 / 0.19) 0%,
                         #10B98110 60%,
                         transparent 100%);
                         -fx-background-radius: 65;"/>
            <Label text="✓"
                   style="-fx-text-fill: #10B981;
                          -fx-font-size: 65px;
                          -fx-font-weight: bold;"/>
        </StackPane>

        <Label text="Payment Confirmed!"
               style="-fx-text-fill: #10B981;
                      -fx-font-size: 28px;
                      -fx-font-weight: bold;"/>
        <Label text="Thank you for dining with us."
               style="-fx-text-fill: #374151; -fx-font-size: 15px;"/>

        <HBox alignment="CENTER" spacing="8">
            <Pane prefWidth="40" prefHeight="1"
                  style="-fx-background-color: #10B981;"/>
            <Label text="✦"
                   style="-fx-text-fill: #10B981; -fx-font-size: 10px;"/>
            <Pane prefWidth="40" prefHeight="1"
                  style="-fx-background-color: #10B981;"/>
        </HBox>

        <Label text="Returning to home screen..."
               style="-fx-text-fill: #9CA3AF;
                      -fx-font-size: 12px;
                      -fx-font-style: italic;"/>
    </VBox>

</StackPane>
