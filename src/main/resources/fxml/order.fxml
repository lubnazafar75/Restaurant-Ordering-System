<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.restaurant.restaurant.ordering.OrderController"
           style="-fx-background-color: #0B0F19;">

    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- SCREEN 1: TABLE NUMBER ENTRY                           -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <VBox fx:id="tableEntryScreen" alignment="CENTER" spacing="20"
          style="-fx-background-color: #0B0F19;">
        <Label text="🍽 Welcome to QuickServe"
               style="-fx-text-fill: white; -fx-font-size: 32px; -fx-font-weight: bold;"/>
        <Label text="Please enter your table number to begin"
               style="-fx-text-fill: #a0aec0; -fx-font-size: 16px;"/>
        <VBox alignment="CENTER" spacing="12" maxWidth="360">
            <TextField fx:id="tableNumberField"
                       promptText="Enter Table Number"
                       style="-fx-background-color: #161D30;
                              -fx-text-fill: white;
                              -fx-font-size: 22px;
                              -fx-font-weight: bold;
                              -fx-alignment: center;
                              -fx-background-radius: 10;
                              -fx-border-color: #FF4A85;
                              -fx-border-radius: 10;
                              -fx-border-width: 2;
                              -fx-padding: 14;
                              -fx-prompt-text-fill: #4a5568;"/>
            <Button text="Start Order →" onAction="#handleStartOrder"
                    maxWidth="Infinity"
                    style="-fx-background-color: #00E676;
                           -fx-text-fill: #0B0F19;
                           -fx-font-size: 16px;
                           -fx-font-weight: bold;
                           -fx-background-radius: 10;
                           -fx-padding: 14;
                           -fx-cursor: hand;"/>
        </VBox>
    </VBox>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- SCREEN 2: MENU + CART                                  -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <HBox fx:id="menuScreen" visible="false" managed="false"
          style="-fx-background-color: #0B0F19;">

        <!-- LEFT: Menu Panel -->
        <VBox prefWidth="580" spacing="0"
              style="-fx-background-color: #0B0F19;
                     -fx-border-color: #161D30;
                     -fx-border-width: 0 1 0 0;">

            <!-- Header -->
            <HBox alignment="CENTER_LEFT" spacing="12"
                  style="-fx-background-color: #0B0F19;
                         -fx-padding: 18 20 14 20;
                         -fx-border-color: #161D30;
                         -fx-border-width: 0 0 1 0;">
                <VBox HBox.hgrow="ALWAYS" spacing="2">
                    <Label text="🍔 Our Menu"
                           style="-fx-text-fill: white;
                                  -fx-font-size: 22px;
                                  -fx-font-weight: bold;"/>
                    <Label fx:id="tableLabel"
                           text="Table —"
                           style="-fx-text-fill: #FF4A85;
                                  -fx-font-size: 12px;
                                  -fx-font-weight: bold;"/>
                </VBox>
                <TextField fx:id="searchField"
                           promptText="🔍 Search food..."
                           onKeyReleased="#handleSearch"
                           prefWidth="180"
                           style="-fx-background-color: #161D30;
                                  -fx-text-fill: white;
                                  -fx-prompt-text-fill: #4a5568;
                                  -fx-background-radius: 8;
                                  -fx-border-color: #2A3350;
                                  -fx-border-radius: 8;
                                  -fx-padding: 8 12;
                                  -fx-font-size: 13px;"/>
            </HBox>

            <!-- Category Tabs -->
            <HBox fx:id="categoryBar" spacing="8"
                  style="-fx-background-color: #0B0F19;
                         -fx-padding: 12 20;
                         -fx-border-color: #161D30;
                         -fx-border-width: 0 0 1 0;"/>

            <!-- Food Grid -->
            <ScrollPane VBox.vgrow="ALWAYS" fitToWidth="true"
                        style="-fx-background-color: #0B0F19;
                               -fx-background: #0B0F19;
                               -fx-border-color: transparent;">
                <FlowPane fx:id="foodGrid" hgap="14" vgap="14"
                          style="-fx-background-color: #0B0F19;
                                 -fx-padding: 16 20;">
                </FlowPane>
            </ScrollPane>
        </VBox>

        <!-- RIGHT: Cart Panel -->
        <VBox HBox.hgrow="ALWAYS" spacing="0"
              style="-fx-background-color: #0D1220;">

            <!-- Cart Header -->
            <VBox style="-fx-padding: 18 20 14 20;
                         -fx-border-color: #1E2740;
                         -fx-border-width: 0 0 1 0;">
                <Label text="🛒 Your Order"
                       style="-fx-text-fill: white;
                              -fx-font-size: 20px;
                              -fx-font-weight: bold;"/>
                <Label fx:id="cartCountLabel"
                       text="0 items"
                       style="-fx-text-fill: #a0aec0;
                              -fx-font-size: 12px;"/>
            </VBox>

            <!-- Cart Items -->
            <ScrollPane VBox.vgrow="ALWAYS" fitToWidth="true"
                        style="-fx-background-color: transparent;
                               -fx-background: transparent;
                               -fx-border-color: transparent;">
                <VBox fx:id="cartItemsBox" spacing="8"
                      style="-fx-background-color: transparent;
                             -fx-padding: 12 16;"/>
            </ScrollPane>

            <!-- Cart Summary -->
            <VBox spacing="10"
                  style="-fx-background-color: #0D1220;
                         -fx-padding: 16 20;
                         -fx-border-color: #1E2740;
                         -fx-border-width: 1 0 0 0;">
                <HBox>
                    <Label text="Subtotal"
                           HBox.hgrow="ALWAYS"
                           style="-fx-text-fill: #a0aec0; -fx-font-size: 13px;"/>
                    <Label fx:id="subtotalLabel" text="GHS 0.00"
                           style="-fx-text-fill: #a0aec0; -fx-font-size: 13px;"/>
                </HBox>
                <HBox>
                    <Label text="VAT (10%)"
                           HBox.hgrow="ALWAYS"
                           style="-fx-text-fill: #a0aec0; -fx-font-size: 13px;"/>
                    <Label fx:id="vatLabel" text="GHS 0.00"
                           style="-fx-text-fill: #a0aec0; -fx-font-size: 13px;"/>
                </HBox>
                <Separator style="-fx-background-color: #1E2740;"/>
                <HBox>
                    <Label text="Total"
                           HBox.hgrow="ALWAYS"
                           style="-fx-text-fill: white;
                                  -fx-font-size: 18px;
                                  -fx-font-weight: bold;"/>
                    <Label fx:id="totalLabel" text="GHS 0.00"
                           style="-fx-text-fill: #00E676;
                                  -fx-font-size: 20px;
                                  -fx-font-weight: bold;"/>
                </HBox>
                <Button text="✓ Place Order" onAction="#handleConfirmOrder"
                        maxWidth="Infinity"
                        style="-fx-background-color: #00E676;
                               -fx-text-fill: #0B0F19;
                               -fx-font-size: 15px;
                               -fx-font-weight: bold;
                               -fx-background-radius: 10;
                               -fx-padding: 14;
                               -fx-cursor: hand;"/>
                <Button text="← Back" onAction="#handleBack"
                        maxWidth="Infinity"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: #a0aec0;
                               -fx-font-size: 13px;
                               -fx-border-color: #2A3350;
                               -fx-border-radius: 8;
                               -fx-background-radius: 8;
                               -fx-padding: 10;
                               -fx-cursor: hand;"/>
            </VBox>
        </VBox>
    </HBox>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- SCREEN 3: ORDER CONFIRMED                              -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <VBox fx:id="confirmScreen" visible="false" managed="false"
          alignment="CENTER" spacing="20"
          style="-fx-background-color: #0B0F19;">
        <Label text="✅"
               style="-fx-font-size: 64px;"/>
        <Label text="Order Placed!"
               style="-fx-text-fill: #00E676;
                      -fx-font-size: 32px;
                      -fx-font-weight: bold;"/>
        <Label fx:id="confirmMessageLabel"
               text="Your order has been sent to the kitchen."
               style="-fx-text-fill: #a0aec0; -fx-font-size: 16px;"/>
        <Label fx:id="orderSummaryLabel" text=""
               style="-fx-text-fill: white;
                      -fx-font-size: 14px;
                      -fx-alignment: center;"
               wrapText="true" maxWidth="400"/>
        <Button text="Track My Order →" onAction="#handleTrackOrder"
                style="-fx-background-color: #00E676;
                       -fx-text-fill: #0B0F19;
                       -fx-font-size: 15px;
                       -fx-font-weight: bold;
                       -fx-background-radius: 10;
                       -fx-padding: 14 30;
                       -fx-cursor: hand;"/>
    </VBox>

</StackPane>