<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<HBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.restaurant.restaurant.login.LoginController"
      maxWidth="Infinity" maxHeight="Infinity"
      style="-fx-background-color: #0B0F19;">

    <!-- LEFT PANEL -->
    <VBox alignment="CENTER" prefWidth="480" minWidth="380"
          style="-fx-background-color: #161D30;
                 -fx-border-color: #1E2740;
                 -fx-border-width: 0 1 0 0;">
        <padding><Insets top="60" right="50" bottom="60" left="50"/></padding>

        <Label text="🍽" style="-fx-font-size: 64px;"/>
        <Label text="Savoria" style="-fx-text-fill: #10B981;
                -fx-font-size: 48px; -fx-font-weight: bold;">
            <VBox.margin><Insets top="12"/></VBox.margin>
        </Label>
        <Label text="— RESTAURANT —"
               style="-fx-text-fill: #F59E0B; -fx-font-size: 12px;
                      -fx-font-weight: bold;">
            <VBox.margin><Insets top="4"/></VBox.margin>
        </Label>
        <Label text="Exceptional Taste, Unforgettable Experience"
               style="-fx-text-fill: #6B7280; -fx-font-size: 13px;"
               wrapText="true">
            <VBox.margin><Insets top="16"/></VBox.margin>
        </Label>

        <Region VBox.vgrow="ALWAYS"/>

        <HBox alignment="CENTER" spacing="20">
            <Label text="👨‍🍳" style="-fx-font-size: 28px;"/>
            <Label text="🍽" style="-fx-font-size: 28px;"/>
            <Label text="👩‍🍳" style="-fx-font-size: 28px;"/>
        </HBox>

        <Label text="Staff Portal — Authorized Access Only"
               style="-fx-text-fill: #4a5568; -fx-font-size: 11px;">
            <VBox.margin><Insets top="16"/></VBox.margin>
        </Label>
    </VBox>

    <!-- RIGHT PANEL: Login Form -->
    <VBox fx:id="loginCard"
          alignment="CENTER"
          HBox.hgrow="ALWAYS"
          style="-fx-background-color: #0B0F19;">
        <padding><Insets top="60" right="80" bottom="60" left="80"/></padding>

        <!-- Back Button -->
        <HBox>
            <Button text="← Back to Home" onAction="#handleBack"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #6B7280; -fx-font-size: 12px;
                           -fx-border-color: #2A3350; -fx-border-radius: 8;
                           -fx-background-radius: 8; -fx-padding: 7 14;
                           -fx-cursor: hand;"/>
            <VBox.margin><Insets bottom="32"/></VBox.margin>
        </HBox>

        <!-- Header -->
        <HBox alignment="CENTER" spacing="12">
            <StackPane minWidth="44" minHeight="44" maxWidth="44" maxHeight="44">
                <VBox prefWidth="44" prefHeight="44"
                      style="-fx-background-color: #10B981;
                             -fx-background-radius: 22;"/>
                <Label text="👤" style="-fx-font-size: 20px;"/>
            </StackPane>
            <Label text="Staff Login"
                   style="-fx-text-fill: white; -fx-font-size: 28px;
                          -fx-font-weight: bold;"/>
        </HBox>

        <!-- Divider -->
        <HBox alignment="CENTER" spacing="8">
            <VBox.margin><Insets top="8" bottom="28"/></VBox.margin>
            <Region prefWidth="60" prefHeight="2"
                    style="-fx-background-color: #F59E0B;"/>
            <Label text="👨‍🍳" style="-fx-font-size: 13px;"/>
            <Region prefWidth="60" prefHeight="2"
                    style="-fx-background-color: #F59E0B;"/>
        </HBox>

        <!-- Staff ID -->
        <Label text="Staff ID"
               style="-fx-text-fill: #a0aec0; -fx-font-size: 13px;
                      -fx-font-weight: bold;">
            <VBox.margin><Insets bottom="6"/></VBox.margin>
        </Label>
        <HBox alignment="CENTER_LEFT"
              style="-fx-background-color: #161D30;
                     -fx-background-radius: 10;
                     -fx-border-color: #2A3350;
                     -fx-border-radius: 10;
                     -fx-border-width: 1.5;
                     -fx-padding: 0 16;">
            <Label text="👤" style="-fx-font-size: 15px; -fx-padding: 0 10 0 0;"/>
            <TextField fx:id="staffIdField"
                       promptText="Enter your Staff ID"
                       HBox.hgrow="ALWAYS"
                       style="-fx-background-color: transparent;
                              -fx-text-fill: white; -fx-font-size: 14px;
                              -fx-border-color: transparent; -fx-padding: 14 0;
                              -fx-prompt-text-fill: #4a5568;"/>
        </HBox>

        <!-- Password -->
        <Label text="Password"
               style="-fx-text-fill: #a0aec0; -fx-font-size: 13px;
                      -fx-font-weight: bold;">
            <VBox.margin><Insets top="16" bottom="6"/></VBox.margin>
        </Label>
        <HBox alignment="CENTER_LEFT"
              style="-fx-background-color: #161D30;
                     -fx-background-radius: 10;
                     -fx-border-color: #2A3350;
                     -fx-border-radius: 10;
                     -fx-border-width: 1.5;
                     -fx-padding: 0 16;">
            <Label text="🔒" style="-fx-font-size: 15px; -fx-padding: 0 10 0 0;"/>
            <PasswordField fx:id="passwordField"
                           promptText="Enter your password"
                           HBox.hgrow="ALWAYS"
                           style="-fx-background-color: transparent;
                                  -fx-text-fill: white; -fx-font-size: 14px;
                                  -fx-border-color: transparent; -fx-padding: 14 0;
                                  -fx-prompt-text-fill: #4a5568;"/>
        </HBox>

        <!-- Error label -->
        <Label fx:id="errorLabel" text=""
               style="-fx-text-fill: #EF4444; -fx-font-size: 13px;"
               visible="false" managed="false" wrapText="true">
            <VBox.margin><Insets top="10"/></VBox.margin>
        </Label>

        <!-- Login Button -->
        <Button fx:id="loginButton"
                text="→   LOGIN"
                onAction="#handleLogin"
                maxWidth="Infinity"
                prefHeight="52"
                style="-fx-background-color: #10B981; -fx-text-fill: white;
               -fx-font-size: 16px; -fx-font-weight: bold;
               -fx-background-radius: 12; -fx-cursor: hand;">
            <VBox.margin><Insets top="20" bottom="24"/></VBox.margin>
        </Button>

        <!-- Security notice -->
        <HBox alignment="CENTER_LEFT" spacing="12"
              style="-fx-background-color: #0D1F17;
                     -fx-background-radius: 10;
                     -fx-border-color: #1A4731;
                     -fx-border-radius: 10;
                     -fx-border-width: 1;
                     -fx-padding: 14 20;">
            <Label text="🛡" style="-fx-font-size: 22px;"/>
            <VBox spacing="2">
                <Label text="Authorized access only."
                       style="-fx-text-fill: #10B981; -fx-font-size: 13px;
                              -fx-font-weight: bold;"/>
                <Label text="All activities are monitored."
                       style="-fx-text-fill: #6B7280; -fx-font-size: 12px;"/>
            </VBox>
        </HBox>

    </VBox>
</HBox>