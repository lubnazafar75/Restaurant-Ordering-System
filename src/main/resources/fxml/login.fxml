<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<HBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.restaurant.restaurant.login.LoginController"
      maxWidth="Infinity" maxHeight="Infinity"
      styleClass="screen-root">

    <!-- LEFT PANEL — Branding (Emerald gradient like landing page) -->
    <VBox alignment="CENTER" prefWidth="480" minWidth="380"
          HBox.hgrow="ALWAYS"
          style="-fx-background-color: linear-gradient(to bottom right, #10B981, #059669);">

        <padding><Insets top="60" right="50" bottom="60" left="50"/></padding>

        <Label text="🍽" style="-fx-font-size: 64px;"/>

        <Label text="Savoria"
               style="-fx-text-fill: white; -fx-font-size: 48px; -fx-font-weight: bold;">
            <VBox.margin><Insets top="12"/></VBox.margin>
        </Label>

        <Label text="— RESTAURANT —"
               style="-fx-text-fill: #FDE68A; -fx-font-size: 12px;
                      -fx-font-weight: bold;">
            <VBox.margin><Insets top="4"/></VBox.margin>
        </Label>

        <Label text="Exceptional Taste, Unforgettable Experience"
               style="-fx-text-fill: #D1FAE5; -fx-font-size: 13px;"
               wrapText="true" textAlignment="CENTER">
            <VBox.margin><Insets top="16"/></VBox.margin>
        </Label>

        <Region VBox.vgrow="ALWAYS"/>

        <HBox alignment="CENTER" spacing="20">
            <Label text="👨‍🍳" style="-fx-font-size: 28px;"/>
            <Label text="🍽" style="-fx-font-size: 28px;"/>
            <Label text="👩‍🍳" style="-fx-font-size: 28px;"/>
        </HBox>

        <Label text="Staff Portal — Authorized Access Only"
               style="-fx-text-fill: #D1FAE5; -fx-font-size: 11px;">
            <VBox.margin><Insets top="16"/></VBox.margin>
        </Label>
    </VBox>

    <!-- RIGHT PANEL: Login Form -->
    <VBox alignment="CENTER" HBox.hgrow="ALWAYS"
          style="-fx-background-color: #F8FAFC;">
        <padding><Insets top="60" right="80" bottom="60" left="80"/></padding>

        <!-- Back Button -->
        <HBox>
            <Button text="← Back to Home" onAction="#handleBack"
                    styleClass="btn-ghost"/>
            <VBox.margin><Insets bottom="32"/></VBox.margin>
        </HBox>

        <!-- Header -->
        <HBox alignment="CENTER" spacing="12">
            <StackPane minWidth="48" minHeight="48" maxWidth="48" maxHeight="48">
                <VBox prefWidth="48" prefHeight="48"
                      style="-fx-background-color: #10B981;
                             -fx-background-radius: 24;"/>
                <Label text="👤" style="-fx-font-size: 22px;"/>
            </StackPane>
            <Label text="Staff Login"
                   style="-fx-text-fill: #1F2937; -fx-font-size: 28px;
                          -fx-font-weight: bold;"/>
        </HBox>

        <!-- Orange divider -->
        <HBox alignment="CENTER" spacing="8">
            <VBox.margin><Insets top="8" bottom="28"/></VBox.margin>
            <Region prefWidth="60" prefHeight="2"
                    style="-fx-background-color: #F59E0B;"/>
            <Label text="👨‍🍳" style="-fx-font-size: 14px;"/>
            <Region prefWidth="60" prefHeight="2"
                    style="-fx-background-color: #F59E0B;"/>
        </HBox>

        <!-- Staff ID -->
        <Label text="Staff ID" styleClass="label-secondary"
               style="-fx-font-size: 13px; -fx-font-weight: bold;">
            <VBox.margin><Insets bottom="6"/></VBox.margin>
        </Label>
        <HBox alignment="CENTER_LEFT" styleClass="input-box">
            <Label text="👤" style="-fx-font-size: 15px; -fx-padding: 0 10 0 0;"/>
            <TextField fx:id="staffIdField"
                       promptText="Enter your Staff ID"
                       HBox.hgrow="ALWAYS"
                       style="-fx-background-color: transparent;
                              -fx-text-fill: #1F2937; -fx-font-size: 14px;
                              -fx-border-color: transparent; -fx-padding: 14 0;
                              -fx-prompt-text-fill: #9CA3AF;"/>
        </HBox>

        <!-- Password -->
        <Label text="Password" styleClass="label-secondary"
               style="-fx-font-size: 13px; -fx-font-weight: bold;">
            <VBox.margin><Insets top="16" bottom="6"/></VBox.margin>
        </Label>
        <HBox alignment="CENTER_LEFT" styleClass="input-box">
            <Label text="🔒" style="-fx-font-size: 15px; -fx-padding: 0 10 0 0;"/>
            <PasswordField fx:id="passwordField"
                           promptText="Enter your password"
                           HBox.hgrow="ALWAYS"
                           style="-fx-background-color: transparent;
                                  -fx-text-fill: #1F2937; -fx-font-size: 14px;
                                  -fx-border-color: transparent; -fx-padding: 14 0;
                                  -fx-prompt-text-fill: #9CA3AF;"/>
        </HBox>

        <!-- Error label -->
        <Label fx:id="errorLabel" text=""
               style="-fx-text-fill: #EF4444; -fx-font-size: 13px;"
               visible="false" managed="false" wrapText="true">
            <VBox.margin><Insets top="10"/></VBox.margin>
        </Label>

        <!-- Login Button -->
        <Button text="→   LOGIN" onAction="#handleLogin"
                maxWidth="Infinity" prefHeight="52"
                styleClass="btn-primary"
                style="-fx-font-size: 16px;">
            <VBox.margin><Insets top="20" bottom="24"/></VBox.margin>
        </Button>

        <!-- Security notice -->
        <HBox alignment="CENTER_LEFT" spacing="12"
              styleClass="login-security-badge">
            <Label text="🛡" style="-fx-font-size: 22px;"/>
            <VBox spacing="2">
                <Label text="Authorized access only."
                       style="-fx-text-fill: #059669; -fx-font-size: 13px;
                              -fx-font-weight: bold;"/>
                <Label text="All activities are monitored."
                       styleClass="label-muted" style="-fx-font-size: 12px;"/>
            </VBox>
        </HBox>

    </VBox>
</HBox>