<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.restaurant.restaurant.menu.MenuController"
            style="-fx-background-color: #163b2c;">

    <!-- TOP: Search Bar -->
    <top>
        <VBox style="-fx-background-color: #163b2c;
                     -fx-border-color: #74c69d;
                     -fx-border-width: 0 0 1 0;">
            <!-- Back button row -->
            <HBox style="-fx-padding: 10 15 0 15;">
                <Button text="← Back"
                        onAction="#handleBack"
                        style="-fx-background-color: #2d6a4f;
                               -fx-text-fill: #ffffff; -fx-font-size: 12px;
                               -fx-border-color: #74c69d; -fx-border-radius: 6;
                               -fx-background-radius: 6; -fx-padding: 6 12;
                               -fx-cursor: hand;"/>
            </HBox>
            <!-- Search row -->
            <HBox spacing="10" style="-fx-padding: 10 15 15 15;" alignment="CENTER_LEFT">
                <Label text="🍔 Menu Management"
                       style="-fx-text-fill: white; -fx-font-size: 18px;
                              -fx-font-weight: bold;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <TextField fx:id="searchField"
                           promptText="🔍 Search food item..."
                           style="-fx-background-color: #163b2c;
                                  -fx-text-fill: white;
                                  -fx-prompt-text-fill: #40916c;
                                  -fx-border-color: #40916c;
                                  -fx-border-radius: 8;
                                  -fx-background-radius: 8;
                                  -fx-padding: 8 12;"
                           prefWidth="220"/>
                <Button text="Search"
                        onAction="#handleSearch"
                        style="-fx-background-color: #74c69d;
                               -fx-text-fill: white; -fx-font-weight: bold;
                               -fx-padding: 8 16; -fx-background-radius: 8;
                               -fx-cursor: hand;"/>
                <ComboBox fx:id="filterCombo"
                          promptText="All Categories"
                          onAction="#handleFilterCategory"
                          style="-fx-background-color: #163b2c;
                                 -fx-text-fill: white;-fx-border-color: #40916c;"
                          prefWidth="160"/>
            </HBox>
        </VBox>
    </top>

    <!-- CENTER: Table -->
    <center>
        <TableView fx:id="menuTable"
                   style="-fx-background-color: #0B0F19;
                          -fx-control-inner-background: #0B0F19;
                          -fx-table-cell-border-color: #1E2740;
                          -fx-padding: 0;"
                   BorderPane.alignment="CENTER">
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="60"/>
                <TableColumn fx:id="colName" text="Food Name" prefWidth="220"/>
                <TableColumn fx:id="colCategory" text="Category" prefWidth="150"/>
                <TableColumn fx:id="colPrice" text="Price (GHS)" prefWidth="120"/>
                <TableColumn fx:id="colAvailable" text="Available" prefWidth="100"/>
            </columns>
            <placeholder>
                <Label text="No menu items found."
                       style="-fx-text-fill: #4a5568; -fx-font-size: 14px;"/>
            </placeholder>
        </TableView>
    </center>

    <!-- RIGHT: Form Panel -->
    <right>
        <VBox spacing="12"
              style="-fx-background-color: #163b2c;
                     -fx-padding: 20;
                     -fx-min-width: 260;
                     -fx-border-color: #74c69d;
                     -fx-border-width: 0 0 0 1;">

            <Label text="Add / Edit Item"
                   style="-fx-text-fill: #d8f3dc; -fx-font-size: 16px;
                          -fx-font-weight: bold;"/>

            <Separator style="-fx-background-color: #d8f3dc;"/>

            <Label text="Item Name"
                   style="-fx-text-fill: #d8f3dc; -fx-font-size: 12px;
                          -fx-font-weight: bold;"/>
            <TextField fx:id="nameField"
                       promptText="Enter item name"
                       style="-fx-background-color: #163b2c;
                              -fx-text-fill: white;
                              -fx-prompt-text-fill: #d8f3dc;
                              -fx-border-color: #2d6a4f;
                              -fx-border-radius: 8;
                              -fx-background-radius: 18;
                              -fx-padding: 10;"/>

            <Label text="Category"
                   style="-fx-text-fill: #163b2c; -fx-font-size: 12px;
                          -fx-font-weight: bold;"/>
            <ComboBox fx:id="categoryCombo"
                      promptText="Select category"
                      maxWidth="Infinity"
                      style="-fx-background-color: #163b2c;
                             -fx-text-fill: #40916c; -fx-border-color: #40916c"/>

            <Label text="Price (GHS)"
                   style="-fx-text-fill: #d8f3dc; -fx-font-size: 12px;
                          -fx-font-weight: bold;"/>
            <TextField fx:id="priceField"
                       promptText="e.g. 45.00"
                       style="-fx-background-color: #163b2c;
                              -fx-text-fill: #d8f3dc;
                              -fx-prompt-text-fill: #74c69d;
                              -fx-border-color: #40916c;
                              -fx-border-radius: 8;
                              -fx-background-radius: 8;
                              -fx-padding: 10;"/>

            <CheckBox fx:id="availableCheck"
                      text="Mark as Available"
                      selected="true"
                      style="-fx-text-fill: #d8f3dc;"/>

            <Separator style="-fx-background-color: #2d6a4f;"/>

            <Button text="✚ Add Item"
                    onAction="#handleAdd"
                    maxWidth="Infinity"
                    style="-fx-background-color: #10B981;
                           -fx-text-fill: white; -fx-font-weight: bold;
                           -fx-padding: 11; -fx-background-radius: 8;
                           -fx-cursor: hand;"/>

            <Button text="✎ Update Item"
                    onAction="#handleUpdate"
                    maxWidth="Infinity"
                    style="-fx-background-color: #3B82F6;
                           -fx-text-fill: white; -fx-font-weight: bold;
                           -fx-padding: 11; -fx-background-radius: 8;
                           -fx-cursor: hand;"/>

            <Button text="✕ Delete Item"
                    onAction="#handleDelete"
                    maxWidth="Infinity"
                    style="-fx-background-color: rgb(16 185 129 / 0.19);
                           -fx-text-fill: white; -fx-font-weight: bold;
                           -fx-padding: 11; -fx-background-radius: 8;
                           -fx-cursor: hand;"/>

            <Button text="↺ Clear Form"
                    onAction="#handleClear"
                    maxWidth="Infinity"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #d8f3dc; -fx-font-size: 12px;
                           -fx-border-color: #2d6a4f; -fx-border-radius: 8;
                           -fx-background-radius: 8; -fx-padding: 8;
                           -fx-cursor: hand;"/>

            <Separator style="-fx-background-color: #2d6a4f;"/>

            <!-- Item count -->
            <Label fx:id="itemCountLabel"
                   text="0 items in menu"
                   style="-fx-text-fill: #d8f3dc; -fx-font-size: 11px;"/>

        </VBox>
    </right>

</BorderPane>