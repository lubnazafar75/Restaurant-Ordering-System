<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.restaurant.restaurant.tracking.CustomerTrackingController"
           styleClass="screen-root">

    <!-- SCREEN 1: TRACKING VIEW -->
    <VBox fx:id="trackingScreen" alignment="TOP_CENTER"
          styleClass="screen-root"
          maxHeight="Infinity">

        <!-- Header -->
        <HBox alignment="CENTER_LEFT" spacing="12"
              styleClass="panel-header">
            <VBox HBox.hgrow="ALWAYS" spacing="3">
                <Label text="🍽 Order Tracking"
                       styleClass="label-heading"/>
                <Label fx:id="orderInfoLabel"
                       text="Tracking your order..."
                       styleClass="label-muted"/>
            </VBox>
            <Button text="← Back to Menu"
                    onAction="#handleBackToMenu"
                    styleClass="btn-ghost"/>
        </HBox>

        <!-- Main Content (no scroll needed) -->
        <VBox alignment="CENTER" spacing="28"
              VBox.vgrow="ALWAYS"
              style="-fx-padding: 30 60 90 60;">

            <!-- Status Card -->
            <VBox alignment="CENTER" spacing="10"
                  maxWidth="700"
                  style="-fx-background-color: white;
                         -fx-background-radius: 20;
                         -fx-border-color: #D1FAE5;
                         -fx-border-radius: 20;
                         -fx-border-width: 2;
                         -fx-padding: 28 32;
                         -fx-effect: dropshadow(gaussian, rgba(16,185,129,0.15), 20, 0, 0, 6);">

                <!-- Icon in soft circle -->
                <StackPane>
                    <VBox prefWidth="84" prefHeight="84"
                          style="-fx-background-color: #F0FDF4;
                                 -fx-background-radius: 50;"/>
                    <Label fx:id="statusEmojiLabel" text="⏳"
                           style="-fx-font-size: 40px;"/>
                </StackPane>

                <Label fx:id="currentStatusLabel" text="Order Received"
                       style="-fx-text-fill: #1F2937;
                              -fx-font-size: 24px;
                              -fx-font-weight: bold;">
                    <VBox.margin><Insets top="6"/></VBox.margin>
                </Label>

                <Label fx:id="statusDescLabel"
                       text="Your order has been received and will be prepared shortly."
                       styleClass="label-muted"
                       wrapText="true"
                       textAlignment="CENTER"
                       maxWidth="420"/>

                <!-- Estimated time hint -->
                <HBox alignment="CENTER" spacing="6"
                      style="-fx-background-color: #FFFBEB;
                             -fx-background-radius: 20;
                             -fx-padding: 6 16;">
                    <Label text="⏱"
                           style="-fx-font-size: 13px;"/>
                    <Label fx:id="estimatedTimeLabel"
                           text="Estimated wait: ~15 minutes"
                           style="-fx-text-fill: #D97706;
                                  -fx-font-size: 12px;
                                  -fx-font-weight: bold;"/>
                </HBox>
            </VBox>

            <!-- Horizontal Progress Tracker -->
            <VBox maxWidth="700" spacing="0"
                  styleClass="card">

                <Label text="ORDER PROGRESS"
                       styleClass="label-caption">
                    <VBox.margin><Insets bottom="20"/></VBox.margin>
                </Label>

                <!-- Progress bar with step circles overlaid -->
                <StackPane>
                    <!-- Background track -->
                    <Region prefHeight="4"
                            maxWidth="Infinity"
                            style="-fx-background-color: #E5E7EB;
                                   -fx-background-radius: 2;">
                        <StackPane.margin><Insets left="22" right="22"/></StackPane.margin>
                    </Region>

                    <!-- Filled progress -->
                    <Region fx:id="progressFill"
                            prefHeight="4"
                            maxWidth="Infinity"
                            style="-fx-background-color: #10B981;
                                   -fx-background-radius: 2;">
                        <StackPane.margin><Insets left="22" right="22"/></StackPane.margin>
                        <StackPane.alignment>CENTER_LEFT</StackPane.alignment>
                    </Region>

                    <!-- Step circles -->
                    <HBox alignment="CENTER" spacing="0"
                          maxWidth="Infinity">
                        <Label fx:id="step1Circle" text="✓"
                               styleClass="step-circle-active"
                               HBox.hgrow="NEVER"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="step2Circle" text="2"
                               styleClass="step-circle-inactive"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="step3Circle" text="3"
                               styleClass="step-circle-inactive"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="step4Circle" text="4"
                               styleClass="step-circle-inactive"/>
                    </HBox>
                </StackPane>

                <!-- Step labels below the bar -->
                <HBox alignment="TOP_CENTER" spacing="0">
                    <VBox.margin><Insets top="10"/></VBox.margin>

                    <VBox alignment="CENTER" spacing="2" maxWidth="140"
                          HBox.hgrow="ALWAYS">
                        <Label fx:id="step1Title" text="Order Received"
                               style="-fx-text-fill: #1F2937; -fx-font-size: 12px;
                                      -fx-font-weight: bold;"
                               textAlignment="CENTER" wrapText="true"/>
                    </VBox>

                    <VBox alignment="CENTER" spacing="2" maxWidth="140"
                          HBox.hgrow="ALWAYS">
                        <Label fx:id="step2Title" text="Being Prepared"
                               style="-fx-text-fill: #9CA3AF; -fx-font-size: 12px;
                                      -fx-font-weight: bold;"
                               textAlignment="CENTER" wrapText="true"/>
                    </VBox>

                    <VBox alignment="CENTER" spacing="2" maxWidth="140"
                          HBox.hgrow="ALWAYS">
                        <Label fx:id="step3Title" text="Ready for Delivery"
                               style="-fx-text-fill: #9CA3AF; -fx-font-size: 12px;
                                      -fx-font-weight: bold;"
                               textAlignment="CENTER" wrapText="true"/>
                    </VBox>

                    <VBox alignment="CENTER" spacing="2" maxWidth="140"
                          HBox.hgrow="ALWAYS">
                        <Label fx:id="step4Title" text="Delivered"
                               style="-fx-text-fill: #9CA3AF; -fx-font-size: 12px;
                                      -fx-font-weight: bold;"
                               textAlignment="CENTER" wrapText="true"/>
                    </VBox>
                </HBox>

                <!-- Current step description -->
                <Label fx:id="stepDescriptionLabel"
                       text="Your order has been placed successfully"
                       styleClass="label-muted"
                       style="-fx-font-size: 12px;"
                       textAlignment="CENTER"
                       wrapText="true"
                       maxWidth="Infinity">
                    <VBox.margin><Insets top="16"/></VBox.margin>
                </Label>
            </VBox>

            <!-- Reassurance note -->
            <Label text="💡 This page updates automatically as our staff process your order."
                   styleClass="label-muted"
                   style="-fx-font-size: 12px;"
                   wrapText="true"
                   textAlignment="CENTER"
                   maxWidth="500"/>

            <!-- Food Received Button -->
            <Button fx:id="foodReceivedBtn"
                    text="✅ Food Received"
                    onAction="#handleFoodReceived"
                    visible="false" managed="false"
                    maxWidth="700"
                    styleClass="btn-primary"
                    style="-fx-font-size: 16px;"/>
        </VBox>
    </VBox>

    <!-- SCREEN 2: FOOD RECEIVED -->
    <VBox fx:id="receivedScreen" visible="false" managed="false"
          alignment="CENTER" spacing="20"
          styleClass="screen-root">
        <StackPane>
            <VBox prefWidth="120" prefHeight="120"
                  style="-fx-background-color: #F0FDF4;
                         -fx-background-radius: 60;"/>
            <Label text="🎉" style="-fx-font-size: 64px;"/>
        </StackPane>
        <Label text="Enjoy Your Meal!"
               style="-fx-text-fill: #10B981;
                      -fx-font-size: 32px;
                      -fx-font-weight: bold;">
            <VBox.margin><Insets top="8"/></VBox.margin>
        </Label>
        <Label text="Thank you for dining with us!"
               styleClass="label-muted" style="-fx-font-size: 15px;"/>
        <VBox spacing="12" maxWidth="360" alignment="CENTER"
              style="-fx-padding: 20 0 0 0;">
            <Button text="🧾 Request Receipt"
                    onAction="#handleRequestReceipt"
                    maxWidth="Infinity"
                    styleClass="btn-primary"
                    style="-fx-font-size: 15px;"/>
            <Button text="🍽 Order More"
                    onAction="#handleOrderMore"
                    maxWidth="Infinity"
                    styleClass="btn-ghost"
                    style="-fx-font-size: 14px; -fx-padding: 12;"/>
        </VBox>
    </VBox>

    <!-- Customer Bottom Navigation Bar -->
    <VBox alignment="BOTTOM_CENTER"
          style="-fx-background-color: transparent;"
          pickOnBounds="false">
        <HBox alignment="CENTER" spacing="0"
              maxWidth="Infinity"
              styleClass="bottom-nav">

            <VBox alignment="CENTER" spacing="4"
                  HBox.hgrow="ALWAYS" maxWidth="Infinity" prefHeight="64"
                  styleClass="bottom-nav-item"
                  onMouseClicked="#handleNavMenu">
                <Label text="🍔" style="-fx-font-size: 20px;"/>
                <Label text="Menu"
                       styleClass="label-muted" style="-fx-font-size: 11px;"/>
            </VBox>

            <VBox alignment="CENTER" spacing="4"
                  HBox.hgrow="ALWAYS" maxWidth="Infinity" prefHeight="64"
                  styleClass="bottom-nav-item, bottom-nav-item-active">
                <Label text="📍" style="-fx-font-size: 20px;"/>
                <Label text="Track Order"
                       style="-fx-text-fill: #10B981;
                              -fx-font-size: 11px;
                              -fx-font-weight: bold;"/>
            </VBox>

            <VBox alignment="CENTER" spacing="4"
                  HBox.hgrow="ALWAYS" maxWidth="Infinity" prefHeight="64"
                  styleClass="bottom-nav-item"
                  onMouseClicked="#handleNavBill">
                <Label text="🧾" style="-fx-font-size: 20px;"/>
                <Label text="My Bill"
                       styleClass="label-muted" style="-fx-font-size: 11px;"/>
            </VBox>

            <VBox alignment="CENTER" spacing="4"
                  HBox.hgrow="ALWAYS" maxWidth="Infinity" prefHeight="64"
                  styleClass="bottom-nav-item"
                  onMouseClicked="#handleNavRate">
                <Label text="⭐" style="-fx-font-size: 20px;"/>
                <Label text="Rate Us"
                       styleClass="label-muted" style="-fx-font-size: 11px;"/>
            </VBox>

            <VBox alignment="CENTER" spacing="4"
                  HBox.hgrow="ALWAYS" maxWidth="Infinity" prefHeight="64"
                  styleClass="bottom-nav-item"
                  onMouseClicked="#handleNavHelp">
                <Label text="💬" style="-fx-font-size: 20px;"/>
                <Label text="Help"
                       styleClass="label-muted" style="-fx-font-size: 11px;"/>
            </VBox>

        </HBox>
    </VBox>
</StackPane>